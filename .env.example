# Copy this file to .env and fill in your key
# DeepSeek API key (used for both tree indexing and text-only queries)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Text model used for indexing + tree-search reasoning + final text answers
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash

# Folder containing your 9 textbook PDFs
PDF_DIR=./textbooks

# Folder where generated PageIndex tree JSONs will be stored
TREE_DIR=./trees

# Max number of PDF pages whose text is extracted and sent per query
MAX_PAGES_PER_QUERY=4
